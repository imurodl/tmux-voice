# API keys for tmux-voice. Copied to ~/.config/tmux-voice/env (mode 600) by install.sh.
# One provider is enough; with both, the second is a fallback.

# ElevenLabs Scribe v2: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Gemini 3.5 Transcribe via Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Or Gemini through Google Cloud (uses `gcloud auth application-default login`) instead of an API key
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
